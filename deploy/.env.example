# Copy to deploy/.env on the server and fill in (docs/DEPLOY.md). Never commit the filled file.

# Domain without subdomain, e.g. gway.app; Caddy serves app., panel., api. and livekit. on it.
DOMAIN=
ACME_EMAIL=

# Supabase (hosted project): Settings > API and Settings > Database > Session pooler.
Supabase__Url=
Supabase__ServiceRoleKey=
ConnectionStrings__Database=Host=;Port=5432;Username=;Password=;Database=postgres;SSL Mode=Require

# LiveKit: any long random strings (the same pair is given to the LiveKit container).
LiveKit__ApiKey=
LiveKit__ApiSecret=

# Twilio Verify (security verification SMS).
Security__Twilio__AccountSid=
Security__Twilio__AuthToken=
Security__Twilio__VerifyServiceSid=
Security__Twilio__LookupLineType=false

# Map tiles (Stadia Maps).
Map__ApiKey=

# Payments (empty: purchases are closed with 503). Setup and the panel addresses: docs/PAYMENTS.md.
Billing__Paytr__MerchantId=
Billing__Paytr__MerchantKey=
Billing__Paytr__MerchantSalt=
Billing__Paytr__TestMode=true
Billing__Iyzico__ApiKey=
Billing__Iyzico__SecretKey=
Billing__Iyzico__BaseUrl=https://sandbox-api.iyzipay.com

# IP country: a DB-IP Lite / GeoLite2 Country file placed in deploy/secrets (optional; without it TR is assumed),
# e.g. /secrets/dbip-country-lite.mmdb
Geo__DatabasePath=
